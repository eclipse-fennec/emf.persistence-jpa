Bundle-Name: Eclipse Fennec Query Model (v2 envelope)
Bundle-Description: The v2 query envelope around the Fennec Expression Model: root type, \
	predicate, ordering, projection, aggregation pipeline, fetch hints, paging, parameters. \
	TRANSITIONAL bundle identity (model2) while the legacy v1 query model is on the \
	buildpath; renamed to org.eclipse.fennec.query.model in the retirement step (#58).

src=${^src},src-gen

-workingset: persistence

-library: enableEMF

-generate:\
	model/query.genmodel;\
		generate=fennecEMF;\
		genmodel=model/query.genmodel;\
		output=src-gen

-includeresource.model: model=model

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.expression.model;version=snapshot

-testpath: \
	assertj-core
