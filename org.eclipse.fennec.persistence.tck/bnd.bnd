Bundle-Name: Eclipse Fennec Persistence TCK
Bundle-Description: Compatibility test suite for EMF persistence backends — the abstract \
	TCK and its model fixtures are consumable API for backend bindings outside this \
	workspace (issue #99); the in-repo JPA/Mongo bindings live in the test sources

-workingset: persistence

-library: enableEMF

-buildpath: \
	biz.aQute.bnd.annotation;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	junit-jupiter-api;version=latest,\
	org.opentest4j;version=latest,\
	assertj-core,\
	org.eclipse.fennec.persistence;version=snapshot,\
	org.eclipse.fennec.persistence.query;version=snapshot,\
	org.eclipse.fennec.persistence.query.derived;version=snapshot,\
	org.eclipse.fennec.persistence.pushstreams;version=snapshot,\
	org.eclipse.fennec.query.model;version=snapshot,\
	org.eclipse.fennec.expression.model;version=snapshot,\
	org.eclipse.fennec.command.model;version=snapshot,\
	org.eclipse.fennec.stream.model;version=snapshot,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest

-testpath: \
	assertj-core,\
	com.h2database,\
	jakarta.persistence-api;version=latest,\
	org.eclipse.persistence.asm;version=latest,\
	org.eclipse.persistence.jpa;version=latest,\
	org.eclipse.persistence.jpa.jpql;version=latest,\
	org.eclipse.persistence.core;version=latest,\
	org.eclipse.fennec.persistence;version=snapshot,\
	org.eclipse.fennec.persistence.query;version=snapshot,\
	org.eclipse.fennec.persistence.query.derived;version=snapshot,\
	org.eclipse.fennec.expression.ocl;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.query.model;version=snapshot,\
	org.eclipse.fennec.expression.model;version=snapshot,\
	org.eclipse.fennec.command.model;version=snapshot,\
	org.eclipse.fennec.stream.model;version=snapshot,\
	org.eclipse.fennec.persistence.orm;version=snapshot,\
	org.eclipse.fennec.persistence.eclipselink;version=snapshot,\
	org.eclipse.fennec.persistence.mongo;version=snapshot,\
	org.eclipse.fennec.persistence.pushstreams;version=snapshot,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.bson;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.mongodb.bson;version=latest,\
	org.mongodb.driver-core;version=latest,\
	org.mongodb.driver-sync;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest
