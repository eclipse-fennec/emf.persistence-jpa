-runfw: org.apache.felix.framework
-runee: JavaSE-21

# SBOM for `./gradlew sbom`: the exporter is included only once it has been fetched (see
# cnf/sbom/plugin.bnd); resolve, the build and the tests ignore both lines.
-include: ${if;${isfile;${workspace}/cnf/cache/sbom-exporter/org.gecko.bnd.sbom.jar};${workspace}/cnf/sbom/plugin.bnd}
-sbom: level=medium, format=cyclonedx

# As in org.eclipse.fennec.persistence.test/test.bndrun, the application uses the
# spifly.dynamic.bundle variant, which wires the org.objectweb.asm bundles, rather than the
# framework extension with its embedded ASM.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

#example
-runrequires: \
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.postgresql.jdbc',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.postgresql',\
	bnd.identity;id='org.eclipse.persistence.asm',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.persistence.moxy',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.orm',\
	bnd.identity;id='org.eclipse.fennec.persistence.pushstreams',\
	bnd.identity;id='org.eclipse.fennec.persistence.mongo',\
	bnd.identity;id='org.eclipse.fennec.persistence.capabilities',\
	bnd.identity;id='org.eclipse.fennec.persistence.query',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.jpa',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.mongo',\
	bnd.identity;id='org.eclipse.fennec.query.model',\
	bnd.identity;id='org.eclipse.fennec.command.model',\
	bnd.identity;id='org.eclipse.fennec.expression.model',\
	bnd.identity;id='org.eclipse.fennec.expression.ocl'
-runbundles: \
	com.h2database;version='[2.5.252,2.5.253)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
