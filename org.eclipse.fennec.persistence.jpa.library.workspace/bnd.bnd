-resourceonly: true
-workingset: persistence
-include: ${.}/buildpath.bnd	
mavendeps: ${sjoin;\n; ${template;-maven-dependencies;${@}}}

-includeresource: {resources}	
	
Provide-Capability: \
	${fennec-base}

fennec-base:\
    bnd.library;\
        bnd.library     = fennecJPA; \
        path            = template
Bundle-Name: Eclipse Fennec Persistence Workspace Library
Bundle-Description: Eclipse Fennec Persistence Workspace Library