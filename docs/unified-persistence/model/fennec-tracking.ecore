<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="tracking" nsURI="https://org.eclipse/fennec/tracking/1.0.0" nsPrefix="tracking">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Fennec tracking aspect metamodel. DRAFT for discussion — see docs/unified-persistence/concept.md (§8, §20).&#xA;&#xA;Declares, per EClass/feature: stable class/feature ids (§4.2), tracking mode and storage profile (§9), change/deletion rules (lifted from org.eclipse.fennec.sensinact.mapping's PersistenceRuleRegistry, §3.6), keyframe cadence (§10), fault policies (§11), reference semantics (canonical side, dangling policy — §5.4).&#xA;&#xA;This model is itself LOG-RELEVANT metadata: id bindings and shape choices affect the reading of historical entries, so tracking changes flow through the snapshot chain and enter the fingerprint (§6, §17.3)."/>
    <details key="basePackage" value="org.eclipse.fennec.model"/>
    <details key="complianceLevel" value="17.0"/>
    <details key="oSGiCompatible" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="TrackingRegistry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Root container. Reusable rules and policies are defined once here and referenced from FeatureTracking via non-containment references (the sensinact PersistenceRuleRegistry pattern)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="packages" upperBound="-1" eType="#//PackageTracking" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Per-EPackage tracking configurations."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="changeRules" upperBound="-1" eType="#//ChangeRule" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Reusable deadband/throttle rules, referenced from FeatureTracking.changeRules."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deletionRules" upperBound="-1" eType="#//DeletionRule" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Reusable retention/housekeeping rules, referenced from FeatureTracking.deletionRule."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="faultPolicies" upperBound="-1" eType="#//FaultPolicy" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Reusable stream-anomaly policies, referenced from FeatureTracking.faultPolicy."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PackageTracking">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Tracking configuration for one EPackage — the granularity at which the interpretation context is fingerprinted and the snapshot chain runs (§6.4)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ePackage" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EPackage this tracking config applies to. Chain/fingerprint granularity is per EPackage (§6.4)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classes" upperBound="-1" eType="#//ClassTracking" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Per-EClass tracking configurations of this package."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassTracking">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Tracking configuration for one EClass: stable class id, stream ownership, keyframe cadence and the per-feature configs. Instances of tracked classes require a stable object id (concept §4.1)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eClass" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EClass this config applies to."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="classId" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Stable class id used in ChangeEntry.classId. Immutable, never reused (protobuf discipline, §4.2). Unique across the WHOLE TrackingRegistry (deployment-wide), not merely per package — required for unambiguous (compositeFingerprint, classId) resolution (concept §6.4, §22 decision #2)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="aggregateRoot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Declares the CAPABILITY: true if instances of this class may own a stream when uncontained (§5.4 base rule 3). Stream ownership follows the instance's containment state — migration can open and close streams (MIGRATE_IN/OUT, §5.4e): roots may demote into another aggregate, children may promote to roots. False = instances only ever occur as containment children; an uncontained instance is then a validation error."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="audit" eType="#//AuditMode" defaultValueLiteral="OFF">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whole-object audit without value capture (concept §8): HEADER records who/when/why (ChangeSet header only), TOUCHED_FEATURES additionally records which feature ids were touched (TOUCH entries, no values — data minimization/privacy). Composes with feature tracking: features may be untracked while audit is on; with feature tracking active, HEADER adds nothing (headers always exist)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="keyframe" eType="#//KeyframeConfig" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Keyframe cadence for streams of this class (§10). Absent = no keyframes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="features" upperBound="-1" eType="#//FeatureTracking" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Per-feature tracking configurations. Untracked features simply have no entry (equivalent to mode=NONE)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureTracking">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Tracking configuration for one feature: the stable feature id, storage profile, addressing shape, reference semantics and the referenced rules (concept §8)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EStructuralFeature this config applies to."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureId" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Stable feature id used in ChangeEntry.featureId (§4.2). Bound to the SEMANTICS of the feature, not its name: renames never change it, ids are never reused. Violations are caught by the fingerprint (§6.5) but tooling should refuse them here."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" lowerBound="1" eType="#//TrackingMode" defaultValueLiteral="NONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Storage profile of this feature's history (concept §9)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="shape" eType="#//FeatureShape" defaultValueLiteral="AUTO">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Addressing mode of the feature (§5.4). AUTO derives it from the Ecore flags (many/ordered/unique, Map$Entry detection — open decision §17.14); explicit values override."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arrayMode" eType="#//ArrayMode" defaultValueLiteral="ATOMIC">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="ARRAY shape only (§5.4i): whole-value SET vs per-cell SET_AT/RESHAPE."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="canonicalSide" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Bidirectional references only (§5.4c): true = this side is recorded, the eOpposite is derived. Exactly one side of a pair may be true; containment sides are always canonical. Unset = not applicable. Part of the interpretation context. Capture normalizes to this side: EMF fires notifications on BOTH ends of an eOpposite pair (EcoreEList.eInverseAdd), in mutation-path-dependent order — one logical change yields exactly one entry, regardless of which side the code mutated. Tooling warns when the canonical side lies outside the referrer's aggregate (inverse then reconstructible only via projection, §22 decision #3)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="childIdentity" eType="#//IdentityStrategy" defaultValueLiteral="AUTO">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Containment references only (concept §4.1, §22 decision #9): how children reached via this feature are identified in streams. AUTO resolves: EMF ID attribute present -> NATURAL; single-valued containment -> SLOT; otherwise tooling demands an explicit choice. Part of the interpretation context."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="matchKeys" upperBound="-1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="NATURAL child identity without an EMF ID attribute: the child features forming the natural key, used by the keyed snapshot diff to correlate incoming children (concept §7.1). Required for multi-valued containments filled by snapshot ingest."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="danglingPolicy" eType="#//DanglingRefPolicy" defaultValueLiteral="KEEP">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cross-aggregate references only (§5.4g): behavior when the referenced target is DELETEd in its own stream."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="changeRules" upperBound="-1" eType="#//ChangeRule">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Deadband/throttle filters applied by the capture pipeline (§7.3). Non-containment: rules are shared, defined in the registry."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deletionRule" eType="#//DeletionRule">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Retention/housekeeping (§8): age- and/or count-based purging. Retention cuts at keyframes (§10). Privacy aspects may constrain this (§8)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="faultPolicy" eType="#//FaultPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Overrides the profile default policy matrix (§11.3) for streams carrying this feature."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="KeyframeConfig">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Manifest cadence (§10, §22 decision #5): a STREAM MANIFEST (ChangeSet with manifest=true carrying KEYFRAMEs of all live objects) is written every 'everyEntries' entries and/or every 'everyDuration' 'durationUnit'. Both unset = no manifests (TIMESERIES samples are their own keyframes, §10). Per-object KEYFRAMEs between manifests are an optional replay optimization."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="everyEntries" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Write a KEYFRAME every n entries. Unset = count-based keyframing off."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="everyDuration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Write a KEYFRAME every 'everyDuration' 'durationUnit'. Unset = time-based keyframing off."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durationUnit" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for everyDuration."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersistenceRule" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Common base for reusable rules; identified by id so FeatureTracking can reference them across files (lifted from sensinact-mapping, §3.6)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unique identifier of this rule, used as the reference target from FeatureTracking (also across files)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Human-readable name."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Human-readable description of intent."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ChangeRule" abstract="true" eSuperTypes="#//PersistenceRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Decides whether a captured change is forwarded to the stream (concept §7.3, §8.1). Rules gate the STREAM only — the current state always follows live values (R3). Comparisons are against the last STORED value (rule-relative closure, R4); the first value, and the first value after any rule change, is always stored (R7). ChangeRules are log-relevant context: changing them produces a new snapshot and fingerprint (R6)."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbsoluteChangeRule" eSuperTypes="#//ChangeRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Store only if |change| >= delta (e.g. 'track only changes > 0.5')."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="delta" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Minimum absolute change against the last stored value."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PercentageChangeRule" eSuperTypes="#//ChangeRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Store only if the value changed by at least 'percentage' percent relative to the last stored value (e.g. '±10%')."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="percentage" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Minimum relative change (percent) against the last stored value."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CountChangeRule" eSuperTypes="#//ChangeRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Store one value out of every 'n' changes (n=1 stores every change)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="n" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Store one out of every n changes; n=1 stores every change."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TimeThrottleChangeRule" eSuperTypes="#//ChangeRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Store at most once per interval; earlier changes are dropped."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Store at most once per 'interval' 'intervalUnit' (e.g. 5 MINUTES)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="intervalUnit" lowerBound="1" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for interval."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DeletionRule" eSuperTypes="#//PersistenceRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Controls purging of stream history (§8, §10). Cuts happen at keyframes; if a cut would remove the last keyframe, housekeeping synthesizes one first. Entries whose ContextSnapshot is still referenced protect that snapshot from GC (§6.4)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="retention" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="History older than 'retention' 'retentionUnit' (e.g. 3 DAYS) is eligible for deletion."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="retentionUnit" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for retention."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optional cap on entries kept per stream/feature (e.g. 'keep the last 100 values')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cleanupInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How often the cleanup runs. Unset = the runtime decides the cadence."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cleanupIntervalUnit" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for cleanupInterval."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FaultPolicy" eSuperTypes="#//PersistenceRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Reaction to stream anomalies (§11): gaps, out-of-order, duplicates. Duplicates are always idempotently skipped via (streamId, sequence); this policy configures the rest. Defaults per storage profile: CHANGELOG strict (BUFFER_AND_WAIT→RESYNC, CONFLICT), TIMESERIES tolerant (SKIP_AND_MARK, INSERT_BY_EVENT_TIME) — §11.3."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gapPolicy" lowerBound="1" eType="#//GapPolicy" defaultValueLiteral="BUFFER_AND_WAIT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Reaction to a missing sequence (§11.1)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bufferTimeout" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="BUFFER_AND_WAIT: how long to hold out-of-sequence entries before escalating to RESYNC."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bufferTimeoutUnit" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for bufferTimeout."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reorderWindow" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Window within which late entries are reordered/re-applied (§11.1)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reorderWindowUnit" eType="#//DurationUnit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unit for reorderWindow."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stalePolicy" eType="#//StalePolicy" defaultValueLiteral="CONFLICT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Handling of entries older than the reorder window."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TrackingMode">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Storage profile of a feature's history (concept §9)."/>
    </eAnnotations>
    <eLiterals name="NONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Feature is not tracked — current-state persistence only."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CHANGELOG" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Delta batches, full width, low frequency — audit, undo, versioning."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="TIMESERIES" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Absolute single-feature samples, narrow layout, high frequency — metrics/analytics. Every sample is its own keyframe (§10)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="FeatureShape">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Addressing mode of a feature (concept §5.4): determines delta kinds, commutativity and conflict granularity — always on (objectId, featureId, address)."/>
    </eAnnotations>
    <eLiterals name="AUTO">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Derive the shape from the Ecore flags (many/ordered/unique; Map$Entry detection — concept §17.14)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SINGLE" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Single-valued: SET/UNSET, no address."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ORDERED_LIST" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Ordered many-valued: ADD/REMOVE/MOVE by index; indices are semantics, operations never commute."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="UNORDERED" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unordered many-valued: addressed by value; ADD/REMOVE commute — relaxed fault policies become legal."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MAP" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Key-addressed (EMap): PUT/REMOVE_KEY; distinct keys commute (§5.4h)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ARRAY" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Array-valued, incl. multidimensional; behavior per arrayMode (§5.4i)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="IdentityStrategy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How containment children are identified in streams. NORMATIVE RULES: concept §4.1 I1-I8 (stream visibility requires identity; SLOT = place history, re-parent = end+begin, no incoming refs; NATURAL/SYNTHETIC = thing history, re-parent = migration; SYNTHETIC persisted with current state; multi-valued ingest needs matchKeys; AUTO resolution)."/>
    </eAnnotations>
    <eLiterals name="AUTO">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Resolve automatically: EMF ID attribute -> NATURAL; single-valued containment -> SLOT; otherwise an explicit choice is demanded (validation)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NATURAL" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="EMF ID attribute or declared matchKeys. Required for multi-valued containments filled by snapshot ingest — nothing else can correlate fresh deserializations."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SLOT" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identity derived from the place: parentId/featureId (single-valued, always safe) or parentId/featureId[index] (multi-valued — ONLY where the index is domain identity, e.g. fixed channel positions; reorderable lists must not use it). Deterministic and coordination-free. Replacing the child instance is indistinguishable from mutating it BY DESIGN — the history belongs to the PLACE, not the thing. Hence: no incoming cross-references, no MIGRATE pair; re-parenting is an end and a beginning (DELETE of the old slot object + CREATE of the new, transaction-linked across streams). If the history must follow the object across re-parenting, SLOT is the wrong strategy — use NATURAL or SYNTHETIC (migration then applies, §5.4e)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SYNTHETIC" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="UUID minted at creation, PERSISTED WITH THE CURRENT STATE (the correlation must survive the DB roundtrip; for JPA enabling tracking may mean a schema addition). Fine for RecordingCapture; NOT usable for pure snapshot ingest of multi-valued children."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="EMBEDDED" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No identity: the child is an atomic value of the parent feature — the whole encoded object travels in SET/ADD deltas (analogous to ArrayMode.ATOMIC). No CREATE/DELETE, no matching. Constraints: not referenced from elsewhere, not tracked itself."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AuditMode">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Class-level whole-object audit mode (concept §8). The object history view itself is a projection over ChangeSet headers (§15) — this mode only controls what capture writes for otherwise untracked changes."/>
    </eAnnotations>
    <eLiterals name="OFF">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No whole-object audit beyond what feature tracking produces."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="HEADER" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Record who/when/why per commit: a ChangeSet header without entries."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="TOUCHED_FEATURES" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Additionally record WHICH features were modified, as TOUCH entries carrying feature ids but no values."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ArrayMode">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Representation of ARRAY-shaped features in the stream (concept §5.4i)."/>
    </eAnnotations>
    <eLiterals name="ATOMIC">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whole array = one value, plain SET. Right for measurement frames (spectra, images) replaced wholesale per timestamp."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ELEMENT_WISE" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Per-cell SET_AT with coordinate vector, plus RESHAPE. Right for large, long-lived, editable grids."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DanglingRefPolicy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Behavior of a cross-aggregate reference when its target is DELETEd in its own stream (concept §5.4g)."/>
    </eAnnotations>
    <eLiterals name="KEEP">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Dangling allowed; resolved lazily, queries see a proxy."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="UNSET" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unset/remove the referrer's value — the FK-nullify analog."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CASCADE" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Tombstone the referrer too. Rare; use deliberately."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GapPolicy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Reaction to a missing sequence in a stream (concept §11.1). Defaults per profile: CHANGELOG strict, TIMESERIES tolerant (§11.3)."/>
    </eAnnotations>
    <eLiterals name="BUFFER_AND_WAIT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Hold out-of-sequence entries for bufferTimeout, waiting for the gap to fill (network reordering case); escalate to RESYNC on timeout."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="RESYNC" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Request full state (get-full) or latest keyframe + deltas, then resume (§11.2)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SKIP_AND_MARK" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Apply anyway and record a hole marker visible to queries/projections. Only sound for absolute-valued streams (TIMESERIES) or after a keyframe."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="QUARANTINE" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Stop applying, park the stream, raise a diagnostic. For must-never-guess data."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StalePolicy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Handling of entries arriving older than the reorder window (concept §11.1)."/>
    </eAnnotations>
    <eLiterals name="CONFLICT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Route to the conflict path (a stale entry may invalidate later valueOld guards). CHANGELOG default."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DROP_AND_AUDIT" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Discard the stale entry but record the fact for audit."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="INSERT_BY_EVENT_TIME" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Accept and insert addressed by event time — late samples are business as usual. TIMESERIES default (late LoRaWAN uplinks)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DurationUnit">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Time unit for durations in rules and policies."/>
    </eAnnotations>
    <eLiterals name="MILLIS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Milliseconds."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SECONDS" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Seconds."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MINUTES" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Minutes."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="HOURS" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Hours."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DAYS" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Days."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
</ecore:EPackage>
