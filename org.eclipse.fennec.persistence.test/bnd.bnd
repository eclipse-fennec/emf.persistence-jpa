Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-workingset: persistence

# Build-order dependencies on all workspace bundles used in the -runbundles
# of test.bndrun, so testOSGi never resolves against stale/missing jars of
# projects that are not on the -buildpath/-testpath (e.g. persistence.ecore,
# expression.ocl).
-dependson: \
	org.eclipse.fennec.command.model,\
	org.eclipse.fennec.expression.model,\
	org.eclipse.fennec.expression.ocl,\
	org.eclipse.fennec.persistence,\
	org.eclipse.fennec.persistence.eclipselink,\
	org.eclipse.fennec.persistence.ecore,\
	org.eclipse.fennec.persistence.mongo,\
	org.eclipse.fennec.persistence.orm,\
	org.eclipse.fennec.persistence.query,\
	org.eclipse.fennec.persistence.query.derived,\
	org.eclipse.fennec.query.model,\
	org.eclipse.fennec.stream.model

-library: \
	enableOSGi-Test,\
	enableEMF
	
-includeresource: \
	data=data

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.eclipse.fennec.persistence.capabilities;version=snapshot,\
	jakarta.persistence-api;version=latest,\
	org.osgi.framework;version=latest,\
	org.osgi.resource;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	biz.aQute.bnd.annotation;version=latest,\
	org.eclipse.persistence.core;version=latest,\
	org.eclipse.persistence.jpa;version=latest,\
	org.eclipse.daanse.jdbc.datasource.h2;version=latest,\
	org.eclipse.fennec.emf.osgi.example.model.basic;version=latest,\
	org.eclipse.fennec.persistence.orm;version=snapshot;packages='*',\
	org.eclipse.fennec.persistence.eclipselink;version=snapshot;packages='*',\
	org.eclipse.fennec.persistence;version=snapshot,\
	org.osgi.service.condition;version=latest,\
	org.osgi.dto;version=latest,\
	com.h2database;version=latest,\
	org.eclipse.fennec.persistence.mongo;version=snapshot,\
	org.mongodb.bson;version=latest,\
	org.mongodb.driver-core;version=latest,\
	org.mongodb.driver-sync;version=latest,\
	org.eclipse.fennec.persistence.query;version=snapshot,\
	org.eclipse.fennec.persistence.query.derived;version=snapshot,\
	org.eclipse.fennec.query.model;version=snapshot,\
	org.eclipse.fennec.expression.model;version=snapshot,\
	org.eclipse.fennec.command.model;version=snapshot,\
	org.eclipse.fennec.stream.model;version=snapshot


-testpath: \
	assertj-core,\
	com.h2database,\
	org.eclipse.persistence.asm;version=latest,\
	org.eclipse.persistence.jpa;version=latest,\
	org.eclipse.persistence.jpa.jpql;version=latest,\
	org.eclipse.persistence.core;version=latest,\
	org.eclipse.fennec.persistence;version=snapshot,\
	org.eclipse.fennec.persistence.query;version=snapshot,\
	org.eclipse.fennec.query.model;version=snapshot,\
	org.eclipse.fennec.expression.model;version=snapshot,\
	org.eclipse.fennec.command.model;version=snapshot,\
	org.eclipse.fennec.stream.model;version=snapshot,\
	org.eclipse.fennec.persistence.orm;version=snapshot,\
	org.eclipse.fennec.persistence.eclipselink;version=snapshot

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *