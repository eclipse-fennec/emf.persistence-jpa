-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.eclipse.fennec.persistence.test',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.ecore',\
	bnd.identity;id='org.eclipse.persistence.asm',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.daanse.jdbc.db.impl',\
	bnd.identity;id='org.eclipse.fennec.persistence.mongo'
	
-runbundles.test: \
	org.eclipse.fennec.persistence.test;version=snapshot

# spifly.dynamic.framework.extension 1.3.6 embeds an ASM that cannot read Java-21
# class files (daanse db.* snapshots) — "ClassFormatError: Weaving hook failed".
# Force the resolver to the dynamic.bundle variant, which wires the current
# org.objectweb.asm 9.9.x bundles instead.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runfw: org.apache.felix.framework

-runee: JavaSE-21

-runproperties: \
	rootPath=${fileuri;./data/citizen.eorm},\
	rootPathConverter=${fileuri;./data/citizen_geojson.eorm},\
	dbPath=${fileuri;./data/h2/citizen},\
	gltdbPath=${fileuri;./data/h2/glt},\
	gltPath=${fileuri;./data/glt/glt.eorm},\
	gltModelPath=${fileuri;./data/glt/glt.ecore}
-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	com.h2database;version='[2.3.232,2.3.233)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	net.bytebuddy.byte-buddy-agent;version='[1.18.4,1.18.5)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.cm.json;version='[2.0.0,2.0.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.daanse.jdbc.datasource.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.h2;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.api;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.impl;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.record;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
