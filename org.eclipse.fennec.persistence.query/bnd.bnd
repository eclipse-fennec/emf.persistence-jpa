Bundle-Name: Eclipse Fennec Persistence Query
Bundle-Description: Backend-neutral query SPI: canonical query.model translated per backend via QueryProcessor

src=${^src},src-gen

-workingset: persistence

-library: enableEMF

-generate:\
	model/query-api.ecore;\
		generate=fennecEMF;\
		genmodel=model/query-api.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

-includeresource.model: model=model

-buildpath: \
	org.eclipse.fennec.persistence.capabilities;version=snapshot,\
	biz.aQute.bnd.annotation;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.eclipse.fennec.persistence;version=snapshot;packages='*',\
	org.eclipse.fennec.query.model;version=snapshot,\
	org.eclipse.fennec.expression.model;version=snapshot,\
	org.eclipse.fennec.command.model;version=snapshot,\
	org.eclipse.fennec.stream.model;version=snapshot

-testpath: \
	assertj-core
