    <eStructuralFeatures xsi:type="ecore:EReference" name="keeper" eType="#//WpCustomer"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="WpLawn" eSuperTypes="#//WpAsset">
